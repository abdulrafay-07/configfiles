theme = "Atom One Dark"

font-family = "JetBrainsMono NFM Regular"

font-size = 16

window-padding-x = 10
window-padding-y = 10

cursor-style = block

mouse-scroll-multiplier = 2

copy-on-select = clipboard

window-padding-balance = true

window-save-state = always

macos-titlebar-style = tabs

window-show-tab-bar = never

background-opacity = 0.7

background-blur = 90

# Keybinds
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right

keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+ctrl+right_bracket=goto_split:next
keybind = super+ctrl+left_bracket=goto_split:previous
keybind = super+ctrl+shift+equal=equalize_splits
